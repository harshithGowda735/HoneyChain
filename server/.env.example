# Talk to HoneyChain - Server Configuration
PORT=3001

# Groq API Key (Primary STT: whisper-large-v3, Free tier: https://console.groq.com)
GROQ_API_KEY=

# Gemini API Key (Required for Grounded LLM Answering and Fallback STT)
# Free tier key at: https://aistudio.google.com
GEMINI_API_KEY=

# Gemini Models
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Firebase Configuration
FIREBASE_PROJECT_ID=honeychain-fa9c9
FIREBASE_SERVICE_ACCOUNT_KEY=

# Mock mode: Set to true only if explicitly testing without API keys
ALLOW_MOCK=false

# ESP32 IoT Telemetry Ingestion Key (Shared secret between physical ESP32 devices and backend)
ESP32_API_KEY=
